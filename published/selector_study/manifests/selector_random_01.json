{
  "schema_version": "tdn-selector-1.0",
  "data": "dataset/weather/weather.csv",
  "target": "OT",
  "train_ratio": 0.7,
  "cardinality": 10,
  "candidate_lags": [
    0,
    1,
    2,
    3,
    6,
    12,
    24,
    48,
    95
  ],
  "screening_horizon": 96,
  "downstream_input": "full_observed_history_of_selected_variables",
  "data_quality": {
    "known_missing_sentinel": -9999.0,
    "selector_preprocessing": "strictly_backward_forward_fill_within_training_partition"
  },
  "selector": "random",
  "repeat": 1,
  "random_seed": 2026,
  "selected_features": [
    "rho_g",
    "PAR_ol",
    "Tdew_degC",
    "T_degC",
    "rain_mm",
    "max_wv",
    "wd_deg",
    "SWDR_W",
    "Tpot_K",
    "rh"
  ]
}